---
import { findRoute, visibleCrumbs } from '../../../../app-routing';
import PageIntro from '../../../../core/components/page-intro/page-intro.component.astro';
import SiteLayout from '../../../../core/components/site-layout/site-layout.component.astro';
import { pageGraph } from '../../../../core/utils/page-meta.util';
import { itemListNode } from '../../../../core/utils/structured-data.util';
import { INDUSTRIES } from '../../data/industries.data';

const route = findRoute('/industrias');
const jsonLd = [
  pageGraph(
    route.path,
    INDUSTRIES.length > 0
      ? [itemListNode('Industrias', INDUSTRIES.map((item) => ({ name: item.crumb, path: item.path })))]
      : [],
  ),
];
---

<SiteLayout title={route.title} description={route.description} path={route.path} jsonLd={jsonLd}>
  <PageIntro
    title="Industrias"
    lead="Contextos de negocio donde la tecnología puede cambiar la forma de operar. Esta sección se publica cuando haya algo listo para mostrar."
    crumbs={visibleCrumbs(route.path)}
    kicker="Industrias"
  />
  <div class="pe-container editorial">
    {
      INDUSTRIES.length === 0 ? (
        <p>Todavía no hay contextos publicados.</p>
      ) : (
        <ul class="block-list">
          {INDUSTRIES.map((industry) => (
            <li>
              <h2>
                <a href={industry.path}>{industry.crumb}</a>
              </h2>
              <p>{industry.lead}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</SiteLayout>
