---
import { findRoute, visibleCrumbs } from '../../../../app-routing';
import ContentSections from '../../../../core/components/content-sections/content-sections.component.astro';
import PageIntro from '../../../../core/components/page-intro/page-intro.component.astro';
import RelatedLinks from '../../../../core/components/related-links/related-links.component.astro';
import SiteLayout from '../../../../core/components/site-layout/site-layout.component.astro';
import { pageGraph } from '../../../../core/utils/page-meta.util';
import { getIndustry } from '../../data/industries.data';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const industry = getIndustry(slug);
const route = findRoute(industry.path);
---

<SiteLayout title={route.title} description={route.description} path={route.path} jsonLd={[pageGraph(route.path)]}>
  <PageIntro title={industry.title} lead={industry.lead} crumbs={visibleCrumbs(route.path)} kicker={industry.kicker} />
  <div class="pe-container editorial">
    <section>
      <h2>Situaciones</h2>
      <ul>
        {industry.situations.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <ContentSections sections={industry.sections} />
    <RelatedLinks links={industry.related} />
  </div>
</SiteLayout>
