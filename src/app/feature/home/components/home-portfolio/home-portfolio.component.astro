---
import './styles/home-portfolio.component.web.css';
import './styles/home-portfolio.component.mobile.css';
import { MESSAGES } from '../../../../core/i18n/messages';
import { withBase } from '../../../../core/utils/public-url.util';

const copy = MESSAGES.es;

const products = [
  { id: 'walogix', n: '1', active: true, points: ['1', '2', '3'], minds: ['1', '2'] },
  { id: 'neurana', n: '2', active: true, points: ['1', '2', '3'], minds: ['1', '2'] },
] as const;

const visibleProducts = products.filter((product) => product.active);
const firstProductId = visibleProducts[0]?.id;

const logos = {
  walogix: {
    dark: '/assets/logo-walogix-dark.png',
    light: '/assets/logo-walogix-light.png',
    darkSize: [748, 601],
    lightSize: [731, 628],
  },
  neurana: {
    dark: '/assets/logo-neurana-dark.png',
    light: '/assets/logo-neurana-light.png',
    darkSize: [671, 372],
    lightSize: [666, 375],
  },
} as const;
---

<section
  class="pe-screen home-portfolio"
  id="portafolio"
  data-pe-section
  data-pe-side="start"
  data-pe-shape="case"
  aria-labelledby="portfolio-title"
>
  <div class="pe-screen__grid">
    <div class="pe-screen__anchor" data-pe-anchor aria-hidden="true"></div>
    <div class="pe-screen__copy home-portfolio__copy">
      <p class="home-portfolio__kicker" data-i18n="portfolio.kicker">{copy['portfolio.kicker']}</p>
      <h2 id="portfolio-title" data-i18n="portfolio.line1">{copy['portfolio.line1']}</h2>
      <p class="home-portfolio__lead" data-i18n="portfolio.lead">{copy['portfolio.lead']}</p>
      <div
        class="home-portfolio__carousel"
        data-pe-portfolio
        data-i18n-aria="portfolio.carousel"
        aria-label={copy['portfolio.carousel']}
        aria-roledescription="carrusel"
      >
        <div class="home-portfolio__viewport">
          {
            products.map((product) => (
              <article
                class:list={['home-portfolio__slide', { 'is-active': product.id === firstProductId }]}
                data-pe-slide
                data-pe-active={product.active ? 'true' : 'false'}
                aria-hidden={product.id === firstProductId ? 'false' : 'true'}
                hidden={!product.active}
              >
                <header class="home-portfolio__identity">
                  <span class="home-portfolio__logo" aria-hidden="true">
                    <img
                      class="home-portfolio__mark home-portfolio__mark--dark"
                      src={withBase(logos[product.id].dark)}
                      width={logos[product.id].darkSize[0]}
                      height={logos[product.id].darkSize[1]}
                      alt=""
                    />
                    <img
                      class="home-portfolio__mark home-portfolio__mark--light"
                      src={withBase(logos[product.id].light)}
                      width={logos[product.id].lightSize[0]}
                      height={logos[product.id].lightSize[1]}
                      alt=""
                    />
                  </span>
                  <div class="home-portfolio__heading">
                    <h3 data-i18n={`portfolio.item${product.n}.name`}>{copy[`portfolio.item${product.n}.name`]}</h3>
                    <p class="home-portfolio__role" data-i18n={`portfolio.item${product.n}.role`}>
                      {copy[`portfolio.item${product.n}.role`]}
                    </p>
                  </div>
                </header>
                <p class="home-portfolio__text" data-i18n={`portfolio.item${product.n}.text`}>
                  {copy[`portfolio.item${product.n}.text`]}
                </p>
                <div class="home-portfolio__facts">
                  <ul class="home-portfolio__points">
                    {
                      product.points.map((point) => (
                        <li data-i18n={`portfolio.item${product.n}.point${point}`}>
                          {copy[`portfolio.item${product.n}.point${point}`]}
                        </li>
                      ))
                    }
                  </ul>
                  <ul class="home-portfolio__mind">
                    {
                      product.minds.map((mind) => (
                        <li>
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path
                              d="M12 4.5a3.2 3.2 0 0 0-2.7 1.5A2.8 2.8 0 0 0 6.2 8.6 2.9 2.9 0 0 0 6.4 13a3 3 0 0 0 2.4 4.2A3.2 3.2 0 0 0 12 19.5a3.2 3.2 0 0 0 3.2-2.3A3 3 0 0 0 17.6 13a2.9 2.9 0 0 0 .2-4.4 2.8 2.8 0 0 0-3.1-2.6A3.2 3.2 0 0 0 12 4.5Z"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.4"
                              stroke-linejoin="round"></path>
                            <path
                              d="M12 5.2v13.6M9.4 9.2c.8.5 1.5.7 2.6.7s1.8-.2 2.6-.7M9.2 13.6c.9.4 1.7.6 2.8.6s1.9-.2 2.8-.6"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.3"
                              stroke-linecap="round"></path>
                          </svg>
                          <span data-i18n={`portfolio.item${product.n}.mind${mind}`}>
                            {copy[`portfolio.item${product.n}.mind${mind}`]}
                          </span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
        <div class="home-portfolio__pager">
          <button
            type="button"
            class="home-portfolio__nav"
            data-pe-prev
            disabled
            data-i18n-aria="portfolio.prev"
            aria-label={copy['portfolio.prev']}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="home-portfolio__pages">
            {
              visibleProducts.map((product, index) => (
                <button
                  type="button"
                  class="home-portfolio__page"
                  data-pe-page
                  aria-current={index === 0 ? 'true' : 'false'}
                  data-i18n-aria={`portfolio.item${product.n}.name`}
                  aria-label={copy[`portfolio.item${product.n}.name`]}
                >
                  {index + 1}
                </button>
              ))
            }
          </div>
          <button
            type="button"
            class="home-portfolio__nav"
            data-pe-next
            data-i18n-aria="portfolio.next"
            aria-label={copy['portfolio.next']}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createSlidePlayer } from '../../carousel-slide';

  const root = document.querySelector<HTMLElement>('[data-pe-portfolio]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-pe-slide]')].filter(
      (slide) => slide.dataset.peActive !== 'false',
    );
    const pages = [...root.querySelectorAll<HTMLButtonElement>('[data-pe-page]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-pe-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-pe-next]');
    let index = 0;
    const player = createSlidePlayer();

    const show = (nextIndex: number) => {
      const outgoing = slides[index];
      const incoming = slides[nextIndex];
      const dir = nextIndex === index ? 0 : nextIndex > index ? 1 : -1;
      index = nextIndex;
      slides.forEach((slide, i) => {
        const on = i === index;
        slide.classList.toggle('is-active', on);
        slide.removeAttribute('hidden');
        slide.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      pages.forEach((page, i) => {
        page.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      if (dir !== 0 && outgoing && incoming) player.play(slides, outgoing, incoming, dir);
    };

    prev?.addEventListener('click', () => {
      if (index > 0) show(index - 1);
    });
    next?.addEventListener('click', () => {
      if (index < slides.length - 1) show(index + 1);
    });
    pages.forEach((page, i) => {
      page.addEventListener('click', () => show(i));
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') next?.click();
      if (event.key === 'ArrowLeft') prev?.click();
    });

    let swipeX = 0;
    let swipeY = 0;
    root.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      swipeX = event.clientX;
      swipeY = event.clientY;
    });
    root.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'mouse') return;
      const dx = event.clientX - swipeX;
      const dy = event.clientY - swipeY;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy) * 1.2) return;
      if (dx < 0) next?.click();
      else prev?.click();
    });
    show(0);
  }
</script>
