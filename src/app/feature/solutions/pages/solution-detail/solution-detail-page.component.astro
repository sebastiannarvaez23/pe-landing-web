---
import { findRoute, visibleCrumbs } from '../../../../app-routing';
import ContentSections from '../../../../core/components/content-sections/content-sections.component.astro';
import PageIntro from '../../../../core/components/page-intro/page-intro.component.astro';
import RelatedLinks from '../../../../core/components/related-links/related-links.component.astro';
import SiteLayout from '../../../../core/components/site-layout/site-layout.component.astro';
import { pageGraph } from '../../../../core/utils/page-meta.util';
import { withBase } from '../../../../core/utils/public-url.util';
import { serviceNode } from '../../../../core/utils/structured-data.util';
import { getSolution } from '../../data/solutions.data';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const solution = getSolution(slug);
const route = findRoute(solution.path);
const jsonLd = [pageGraph(route.path, [serviceNode(route, solution.serviceType)])];
---

<SiteLayout title={route.title} description={route.description} path={route.path} jsonLd={jsonLd}>
  <PageIntro title={solution.title} lead={solution.lead} crumbs={visibleCrumbs(route.path)} kicker={solution.kicker} />
  <div class="pe-container editorial">
    <section>
      <h2>Cuándo tiene sentido</h2>
      <ul>
        {solution.situations.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <ContentSections sections={solution.sections} />
    <p>
      <a href={withBase('/contacto')}>Contacto</a>
    </p>
    <RelatedLinks links={solution.related} />
  </div>
</SiteLayout>
